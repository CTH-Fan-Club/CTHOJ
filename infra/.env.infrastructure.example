# CTHOJ business data services
CTHOJ_POSTGRES_IMAGE=postgres:16.2-alpine
CTHOJ_POSTGRES_DB=cthoj
CTHOJ_POSTGRES_USER=cthoj
CTHOJ_POSTGRES_PASSWORD=__GENERATE_HEX_32__
CTHOJ_POSTGRES_BIND_ADDRESS=127.0.0.1
CTHOJ_POSTGRES_PORT=5432

CTHOJ_REDIS_IMAGE=redis:7.2.4-alpine
CTHOJ_REDIS_PASSWORD=__GENERATE_HEX_32__
CTHOJ_REDIS_BIND_ADDRESS=127.0.0.1
CTHOJ_REDIS_PORT=6379
CTHOJ_REDIS_MAX_MEMORY=256mb

# Judge0 has a separate PostgreSQL and Redis. Do not share the CTHOJ instances.
JUDGE0_IMAGE=cthoj/judge0-cgroupv2:1.13.1-isolate2.6
JUDGE0_POSTGRES_IMAGE=postgres:16.2-alpine
JUDGE0_REDIS_IMAGE=redis:7.2.4-alpine
JUDGE0_POSTGRES_DB=judge0
JUDGE0_POSTGRES_USER=judge0
JUDGE0_POSTGRES_PASSWORD=__GENERATE_HEX_32__
JUDGE0_REDIS_PASSWORD=__GENERATE_HEX_32__
JUDGE0_AUTH_HEADER=X-Auth-Token
JUDGE0_AUTH_TOKEN=__GENERATE_HEX_32__
JUDGE0_BIND_ADDRESS=127.0.0.1
JUDGE0_PORT=2358
JUDGE0_ALLOW_IP=
JUDGE0_WORKERS=1
JUDGE0_MAX_QUEUE_SIZE=50
JUDGE0_CPU_TIME_LIMIT=5
JUDGE0_MAX_CPU_TIME_LIMIT=15
JUDGE0_MEMORY_LIMIT=262144
JUDGE0_MAX_MEMORY_LIMIT=524288
